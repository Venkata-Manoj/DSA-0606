      <column caption='Quadrant' datatype='string' name='[Calculation_0699319837110277]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Shipment_Volume_k] &gt; 400 AND [On_Time_Delivery_Pct] &lt; 90 THEN &quot;Critical Risk&quot;&#13;&#10;ELSEIF [Shipment_Volume_k] &gt; 400 AND [On_Time_Delivery_Pct] &gt;= 90 THEN &quot;Star Supplier&quot;&#13;&#10;ELSEIF [Shipment_Volume_k] &lt;= 400 AND [On_Time_Delivery_Pct] &lt; 90 THEN &quot;Watch&quot;&#13;&#10;ELSE &quot;Niche Supplier&quot;&#13;&#10;END' />
      </column>
